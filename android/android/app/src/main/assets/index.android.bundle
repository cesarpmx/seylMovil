    background-color: var(--overlay-color);
    opacity: 0;
    transition: opacity 0.15s;
  }

  a:hover > .${f}, button:hover > .${f} {
    opacity: var(--overlay-hover-opacity);
  }

  a:active > .${f}, button:active > .${f} {
    opacity: var(--overlay-active-opacity);
  }
